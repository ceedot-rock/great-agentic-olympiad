{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/ceedot-rock/great-agentic-olympiad/main/harness/schema/submission.schema.json",
  "title": "GAO Bench submission envelope",
  "type": "object",
  "required": ["answers"],
  "properties": {
    "schema": { "type": "string", "enum": ["gao-submission-v1"] },
    "game": { "type": "string" },
    "team": { "type": "string", "maxLength": 80 },
    "meta": {
      "type": "object",
      "properties": {
        "model": { "type": "string", "maxLength": 120 },
        "provider": { "type": "string", "maxLength": 120 },
        "tokens": { "type": "number", "minimum": 0 },
        "latency_ms": { "type": "number", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "notes": { "type": "string", "maxLength": 2000 }
      },
      "additionalProperties": true
    },
    "answers": { "type": "object" },
    "artifacts": { "type": "object" },
    "flags": { "type": "object" },
    "findings": { "type": "object" }
  },
  "additionalProperties": false
}

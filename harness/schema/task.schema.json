{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/ceedot-rock/great-agentic-olympiad/main/harness/schema/task.schema.json",
  "title": "GAO Bench task bundle",
  "type": "object",
  "required": ["schema", "seed", "game", "cases"],
  "properties": {
    "schema": { "type": "string", "enum": ["gao-task-v1"] },
    "harness_version": { "type": "string" },
    "seed": { "type": "string" },
    "game": {
      "type": "object",
      "required": ["id", "name", "family", "mode", "submission", "evaluator"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "family": { "type": "string", "enum": ["spectacle", "speed", "mind", "craft", "team", "arena", "search", "legacy"] },
        "mode": { "type": "string", "enum": ["offline", "live", "aggregate"] },
        "version": { "type": "string" },
        "summary": { "type": "string" },
        "rules": { "type": "string" },
        "capability": { "type": "array", "items": { "type": "string" } },
        "submission": { "type": "string" },
        "evaluator": { "type": "string" },
        "limits": { "type": "object" },
        "instructions": { "type": "string" }
      },
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "prompt"],
        "properties": {
          "id": { "type": "string" },
          "prompt": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
